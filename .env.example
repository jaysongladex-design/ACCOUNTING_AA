# -----------------------------------------------------------
# Settings template.
# 1. Make a copy of this file and name the copy ".env"
# 2. Fill in your real values below.
# The real ".env" file is kept private and NOT uploaded to GitHub.
# -----------------------------------------------------------

# Example: an API key or login for a service you automate
API_KEY=your_api_key_here

# Example: a website or account you work with
USERNAME=your_username_here
PASSWORD=your_password_here

# How much detail to show in logs: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
